{
  "manifest_version": 3,
  "name": "Stream Radio Mode",
  "version": "1.7.0",
  "description": "숲(SOOP) 라디오 모드 + 멀티뷰(치지직·숲·트위치·유튜브 동시 시청, 오디오 믹서). 수면모드, 루팡모드, 대사 EQ, 단축키 지원.",
  "permissions": ["storage", "activeTab", "tabs"],
  "optional_permissions": ["declarativeNetRequest", "scripting"],
  "optional_host_permissions": [
    "*://api.chzzk.naver.com/*",
    "*://chzzk.naver.com/*",
    "*://play.sooplive.com/*",
    "*://play.sooplive.co.kr/*",
    "*://live.sooplive.co.kr/*",
    "*://sch.sooplive.co.kr/*",
    "*://player.twitch.tv/*",
    "*://www.twitch.tv/*",
    "*://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.sooplive.co.kr/*", "*://*.sooplive.com/*"],
      "js": ["content/paste-unlock.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.sooplive.co.kr/*", "*://*.sooplive.com/*"],
      "js": [
        "content/ui-dark-theme.js",
        "content/ui-actions.js",
        "content/ui-list.js",
        "content/ui-chat.js",
        "content/ui.js",
        "content/bandwidth.js",
        "content/speech-eq.js",
        "content/core.js",
        "content/boss.js",
        "content/soop.js"
      ],
      "css": ["styles/radio-overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://vod.sooplive.co.kr/player/*", "*://vod.sooplive.com/player/*"],
      "js": ["content/bandwidth-frame.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "toggle-radio": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "라디오 모드 토글 (브라우저 어디서나)"
    },
    "toggle-boss": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "루팡 모드 토글 (브라우저 어디서나)"
    },
    "toggle-minimize": {
      "description": "최소화 모드 토글 (브라우저 어디서나)"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/bandwidth-inject.js"],
      "matches": ["*://*.sooplive.co.kr/*", "*://*.sooplive.com/*"]
    }
  ]
}
